# Facebook Graph API — copy to `.env` for local `vercel dev`, and set the same
# keys in the Vercel dashboard (Project → Settings → Environment Variables).
# Never commit the real values.

# Numeric ID of the Páteo Facebook Page (see the setup guide)
FB_PAGE_ID=

# Long-lived Page access token
FB_ACCESS_TOKEN=

# Optional: override the Graph API version (defaults to v21.0 in the function)
# FB_GRAPH_VERSION=v21.0
