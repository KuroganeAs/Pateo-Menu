# Copy to backend/.env and adjust.

# PostgreSQL connection (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/menu_app

# JWT signing secret — CHANGE for anything beyond a throwaway local run
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=720

# Default admin seeded on first startup (only if no admin users exist yet).
# CHANGE THE PASSWORD before real use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Uploads
MAX_UPLOAD_MB=5
# UPLOAD_DIR=C:/somewhere/uploads   (default: backend/uploads)

# CORS — comma-separated origins, or * for local dev.
# In production list the customer site and admin panel origins, e.g.
# CORS_ORIGINS=https://your-site.vercel.app,https://your-admin.vercel.app
CORS_ORIGINS=*
